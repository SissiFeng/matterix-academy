output "app_url" { value = "https://${aws_cloudfront_distribution.web.domain_name}" }
output "frontend_bucket" { value = aws_s3_bucket.web.id }
output "distribution_id" { value = aws_cloudfront_distribution.web.id }
output "lambda_function" { value = aws_lambda_function.api.function_name }
output "cognito_pool_id" { value = aws_cognito_user_pool.learners.id }
output "worker_api_url" { value = aws_apigatewayv2_api.worker.api_endpoint }
output "records_table" { value = aws_dynamodb_table.records.name }
output "worker_lambda_functions" { value = [for item in aws_lambda_function.worker : item.function_name] }
output "remote_execution_enabled" { value = var.remote_execution_enabled }
output "github_role_arn" { value = try(aws_iam_role.github_deploy[0].arn, null) }
output "sim2real_lambda_functions" { value = [for item in aws_lambda_function.sim2real_authorizer : item.function_name] }
