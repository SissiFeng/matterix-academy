{
  "name": "matterix-academy-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.mjs *.mts *.ts *.json index.html",
    "format:check": "prettier --check src tests *.mjs *.mts *.ts *.json index.html",
    "commissioning:live": "node commissioning.mjs",
    "acceptance:learners": "node learner-acceptance.mjs",
    "test:acceptance": "node --test learner-acceptance.test.mjs",
    "commissioning:studio": "node studio-commissioning.mjs",
    "test:studio-commissioning": "node --test studio-commissioning.test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "lucide-react": "^0.468.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
